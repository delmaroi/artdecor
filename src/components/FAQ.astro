---
import { Icon } from "astro-icon/components";
import { homeFaqs, type FaqItem } from "../lib/faq-data";

export interface Props {
  faqs?: FaqItem[];
  emitJsonLd?: boolean;
}

const { faqs = homeFaqs, emitJsonLd = true } = Astro.props;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.a,
    },
  })),
};
---

{emitJsonLd && (
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
)}

<section class="section faq-section" id="faq">
  <div class="container faq-layout">
    <div class="faq-section-header">
      <p class="eyebrow">Pytania i odpowiedzi</p>
      <h2 class="faq-heading">Często zadawane <em>pytania</em></h2>
      <p class="faq-lead">Masz wątpliwości? Przygotowaliśmy odpowiedzi na najczęstsze pytania naszych klientów.</p>
      <a href="/kontakt/" class="faq-cta">
        Zadaj własne pytanie
        <Icon name="lucide:arrow-up-right" size={18} />
      </a>
    </div>

    <div class="faq-list">
      {faqs.map((item, index) => (
        <div class="faq-item" data-reveal data-reveal-dir="up" data-reveal-delay={index * 0.1}>
          <button class="faq-question" aria-expanded="false">
            <span>{item.q}</span>
            <span class="faq-icon-wrap" aria-hidden="true">
              <Icon name="lucide:plus" size={20} class="faq-icon" />
            </span>
          </button>
          <div class="faq-answer">
            <div class="faq-answer-content">
              <p>{item.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  function initFAQ() {
    const faqItems = document.querySelectorAll('.faq-list .faq-item');

    faqItems.forEach(item => {
      const button = item.querySelector('.faq-question');

      button.addEventListener('click', () => {
        const isExpanded = button.getAttribute('aria-expanded') === 'true';

        // Close all other items (optional, but cleaner)
        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            otherItem.querySelector('.faq-question').setAttribute('aria-expanded', 'false');
            otherItem.querySelector('.faq-answer').style.maxHeight = null;
          }
        });

        // Toggle current item
        button.setAttribute('aria-expanded', !isExpanded);
        const answer = item.querySelector('.faq-answer');

        if (!isExpanded) {
          answer.style.maxHeight = answer.scrollHeight + "px";
        } else {
          answer.style.maxHeight = null;
        }
      });
    });
  }

  // Init on load
  document.addEventListener('DOMContentLoaded', initFAQ);
  // Init on view transitions
  document.addEventListener('astro:after-swap', initFAQ);
</script>

<style>
  .faq-section {
    background: var(--structa-offwhite);
  }

  .faq-layout {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 1024px) {
    .faq-layout {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
      align-items: start;
    }

    .faq-section-header {
      position: sticky;
      top: 140px;
    }
  }

  .faq-section-header .eyebrow {
    margin: 0 0 1.25rem;
  }

  .faq-heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 0 0 1.25rem;
    color: var(--structa-black);
  }

  .faq-heading em {
    font-style: normal;
    color: var(--structa-accent);
  }

  .faq-lead {
    color: var(--structa-gray-text);
    font-size: 1.0625rem;
    line-height: 1.65;
    margin: 0 0 2rem;
    max-width: 40ch;
  }

  .faq-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--structa-black);
    border-bottom: 2px solid var(--structa-accent);
    padding-bottom: 0.35rem;
    transition: color var(--transition-fast);
  }

  .faq-cta:hover {
    color: var(--structa-accent);
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--paper-line);
  }

  .faq-item {
    border-bottom: 1px solid var(--paper-line);
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0.25rem;
    background: none;
    border: none;
    color: var(--structa-black);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-align: left;
    cursor: pointer;
    gap: 1.5rem;
    transition: color var(--transition-fast);
  }

  .faq-question:hover {
    color: var(--structa-accent);
  }

  .faq-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--paper-line);
    border-radius: 50%;
    color: var(--structa-black);
    flex-shrink: 0;
    transition: all var(--transition-base);
  }

  .faq-question[aria-expanded="true"] .faq-icon-wrap {
    background: var(--structa-accent);
    border-color: var(--structa-accent);
    color: #fff;
    transform: rotate(45deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-answer-content {
    padding: 0 3.5rem 1.5rem 0.25rem;
  }

  .faq-answer p {
    color: var(--structa-gray-text);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 640px) {
    .faq-question {
      font-size: 1rem;
      padding: 1.25rem 0;
    }

    .faq-answer-content {
      padding: 0 2rem 1.25rem 0;
    }
  }
</style>
