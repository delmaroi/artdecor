---
import { Image } from "astro:assets";
import SectionHeader from "./SectionHeader.astro";
import { asset } from "../lib/images";

const logos = Array.from({ length: 10 }, (_, i) => `/images/klienci/${i + 1}.png`);
---
<section class="section clients" id="klienci">
  <div class="container">
    <SectionHeader
      eyebrow="Nasi zaufani partnerzy"
      title="Zaufali nam"
      accent="nam"
      align="stack"
    />
  </div>

  <div class="clients-marquee" role="list" aria-label="Logotypy klientów Art Decor">
    <div class="clients-track">
      {[0, 1].map((copy) => (
        <div class="clients-group" aria-hidden={copy === 1 ? "true" : undefined}>
          {logos.map((logo, i) => (
            <div class="client-cell" role={copy === 0 ? "listitem" : undefined}>
              <Image
                src={asset(logo)}
                alt={copy === 0 ? `Logo klienta Art Decor Pszczyna #${i + 1} — współpraca w zakresie reklamy wizualnej` : ""}
                class="client-logo"
                loading="lazy"
                decoding="async"
                width={240}
              />
            </div>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clients {
    overflow: hidden;
  }

  /* Nagłówek sekcji renderuje SectionHeader.astro — style w globals.css. */

  .clients-marquee {
    position: relative;
    overflow: hidden;
    border-block: 1px solid var(--paper-line);
    padding-block: 2.25rem;
    /* Wygaszenie krawędzi */
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .clients-track {
    display: flex;
    width: max-content;
    animation: marquee 35s linear infinite;
  }

  .clients-marquee:hover .clients-track {
    animation-play-state: paused;
  }

  .clients-group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .client-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 180px;
    height: 72px;
    margin-inline: 2.5rem;
    flex-shrink: 0;
  }

  .client-logo {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.55;
    transition: filter var(--transition-base), opacity var(--transition-base);
  }

  .client-cell:hover .client-logo {
    filter: grayscale(0);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .clients-track {
      animation: none;
      flex-wrap: wrap;
      width: 100%;
      justify-content: center;
    }
    .clients-group[aria-hidden="true"] {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .client-cell {
      width: 130px;
      height: 56px;
      margin-inline: 1.5rem;
    }
  }
</style>
