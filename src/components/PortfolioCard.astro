---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  category: string;
  meta: ImageMetadata;
  href: string;
  width: number;
  height: number;
}

const { title, category, meta, href, width, height } = Astro.props;
---
<li class="portfolio-item" data-category={category.toLowerCase().replace(/\s+/g, "-")}>
  <figure class="portfolio-card">
    <a
      class="portfolio-image-wrapper"
      href={href}
      data-pswp-width={width}
      data-pswp-height={height}
      data-caption={`${category} — ${title}`}
      target="_blank"
      rel="noopener"
      aria-label={`Powiększ: ${title}`}
    >
      <Image
        src={meta}
        alt={`${title} — realizacja Art Decor Pszczyna, kategoria: ${category}`}
        loading="lazy"
        decoding="async"
        width={800}
        widths={[400, 800]}
        sizes="(min-width: 1024px) 420px, (min-width: 640px) 50vw, 100vw"
        quality={72}
      />
      <span class="portfolio-hover-icon" aria-hidden="true">
        <Icon name="lucide:expand" size={20} />
      </span>
    </a>
    <figcaption class="portfolio-caption">
      <div>
        <p class="portfolio-category">{category}</p>
        <h3 class="portfolio-title">{title}</h3>
      </div>
    </figcaption>
  </figure>
</li>

<style>
  .portfolio-card {
    margin: 0;
  }

  .portfolio-image-wrapper {
    display: block;
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--structa-offwhite);
  }

  .portfolio-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portfolio-item:hover .portfolio-card img {
    transform: scale(1.06);
  }

  .portfolio-hover-icon {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--structa-white);
    color: var(--structa-black);
    border-radius: 50%;
    opacity: 0;
    transform: translateY(8px);
    transition: all var(--transition-base);
  }

  .portfolio-item:hover .portfolio-hover-icon {
    opacity: 1;
    transform: translateY(0);
  }

  .portfolio-caption {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
  }

  .portfolio-category {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--structa-accent);
    margin: 0 0 0.35rem;
  }

  .portfolio-title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--structa-black);
    margin: 0;
    line-height: 1.25;
  }
</style>
