---
import SectionHeader from "./SectionHeader.astro";
import SectionRule from "./SectionRule.astro";
import { bestFit } from "../lib/narrative-data";
---
<section class="section best-fit" id="dla-kogo">
  <div class="container">
    <SectionRule />
    <SectionHeader
      eyebrow={bestFit.eyebrow}
      title={bestFit.title}
      accent={bestFit.accent}
      align="stack"
    />

    <ul class="fit-grid" data-stagger-grid>
      {bestFit.criteria.map((item) => (
        <li class="fit-card">
          <h3 class="fit-card-title">{item.title}</h3>
          <p class="fit-card-body">{item.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .best-fit {
    background: var(--structa-white);
  }

  .fit-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 900px) {
    .fit-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .fit-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 2.25rem;
    background: var(--structa-offwhite);
    border: 1px solid var(--structa-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .fit-card:hover {
    border-color: var(--structa-accent);
    transform: translateY(-4px);
  }

  .fit-card-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--structa-black);
    margin: 0;
  }

  .fit-card-body {
    font-size: 0.9688rem;
    line-height: 1.65;
    color: var(--structa-gray-text);
    margin: 0;
  }
</style>
