---
/**
 * HeroCanvasArtDeco — Animated Art Deco hero background
 * Layered, professional animation inspired by 1920s Art Deco design.
 * Designed to harmonize with the underlying SVG art deco backdrop.
 *
 * Elements:
 * - Slowly rotating sunburst rays anchored at the bottom-center
 * - Subtle pulsing concentric arches above the rays
 * - Floating diamond/lozenge medallions drifting upward
 * - Geometric chevron particles with brass-tone glow
 * - Animated metallic shimmer sweep across the scene
 * - Reduced-motion fallback
 *
 * Brand palette: charcoal #232D48, accent #FF5C35, brass #D6A05C, white
 */
---

<canvas id="hero-canvas-artdeco" aria-hidden="true"></canvas>

<script is:inline>
(function() {
  const canvas = document.getElementById('hero-canvas-artdeco');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');

  // ========= CONFIG =========
  const ACCENT     = { r: 255, g: 92,  b: 53  };   // brand orange
  const BRASS      = { r: 214, g: 160, b: 92  };   // art deco brass
  const HIGHLIGHT  = { r: 255, g: 217, b: 168 };   // pale champagne
  const PARTICLE_COUNT = 28;     // floating diamonds
  const SPARK_COUNT    = 60;     // tiny brass sparkles
  const prefersReduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let W, H, dpr;
  let particles = [];
  let sparks = [];
  let mouse = { x: -9999, y: -9999, active: false };
  let time = 0;
  let animId;

  // ========= RESIZE =========
  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    const rect = canvas.parentElement.getBoundingClientRect();
    W = rect.width;
    H = rect.height;
    canvas.width  = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width  = W + 'px';
    canvas.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  // ========= FLOATING DIAMOND MEDALLION =========
  function Diamond() { this.reset(true); }
  Diamond.prototype.reset = function(initial) {
    this.x = Math.random() * W;
    this.y = initial ? Math.random() * H : H + 40;
    this.size = 6 + Math.random() * 14;
    this.vy = -(0.08 + Math.random() * 0.18);
    this.vx = (Math.random() - 0.5) * 0.12;
    this.rot = Math.random() * Math.PI;
    this.rotSpeed = (Math.random() - 0.5) * 0.004;
    this.opacity = 0.18 + Math.random() * 0.35;
    this.isAccent = Math.random() < 0.35;
    this.pulse = Math.random() * Math.PI * 2;
  };
  Diamond.prototype.update = function() {
    this.x += this.vx;
    this.y += this.vy;
    this.rot += this.rotSpeed;
    if (this.y < -40) this.reset(false);
    if (this.x < -40) this.x = W + 40;
    if (this.x > W + 40) this.x = -40;
  };
  Diamond.prototype.draw = function() {
    const c = this.isAccent ? ACCENT : BRASS;
    const pulse = Math.sin(time * 0.0015 + this.pulse) * 0.5 + 0.5;
    const op = this.opacity * (0.7 + pulse * 0.3);

    ctx.save();
    ctx.translate(this.x, this.y);
    ctx.rotate(this.rot);
    ctx.globalAlpha = op;
    ctx.shadowBlur = 14;
    ctx.shadowColor = 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + (op * 0.9) + ')';

    // Outer diamond outline
    ctx.beginPath();
    ctx.moveTo(0, -this.size);
    ctx.lineTo(this.size * 0.78, 0);
    ctx.lineTo(0, this.size);
    ctx.lineTo(-this.size * 0.78, 0);
    ctx.closePath();
    ctx.strokeStyle = 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + op + ')';
    ctx.lineWidth = 1.1;
    ctx.stroke();

    // Inner accent
    ctx.beginPath();
    ctx.moveTo(0, -this.size * 0.5);
    ctx.lineTo(this.size * 0.4, 0);
    ctx.lineTo(0, this.size * 0.5);
    ctx.lineTo(-this.size * 0.4, 0);
    ctx.closePath();
    ctx.fillStyle = 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + (op * 0.4) + ')';
    ctx.fill();

    ctx.restore();
  };

  // ========= BRASS SPARKS =========
  function Spark() { this.reset(true); }
  Spark.prototype.reset = function(initial) {
    this.x = Math.random() * W;
    this.y = initial ? Math.random() * H : Math.random() * H;
    this.r = 0.6 + Math.random() * 1.4;
    this.life = Math.random() * Math.PI * 2;
    this.lifeSpeed = 0.008 + Math.random() * 0.02;
    this.isAccent = Math.random() < 0.25;
  };
  Spark.prototype.update = function() {
    this.life += this.lifeSpeed;
    this.y -= 0.05;
    if (this.y < -10 || this.life > Math.PI * 4) {
      this.life = 0;
      this.x = Math.random() * W;
      this.y = H + 10;
    }
  };
  Spark.prototype.draw = function() {
    const c = this.isAccent ? ACCENT : HIGHLIGHT;
    const op = Math.max(0, Math.sin(this.life)) * 0.7;
    if (op < 0.02) return;
    ctx.save();
    ctx.globalAlpha = op;
    ctx.shadowBlur = 8;
    ctx.shadowColor = 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',' + op + ')';
    ctx.beginPath();
    ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(' + c.r + ',' + c.g + ',' + c.b + ',1)';
    ctx.fill();
    ctx.restore();
  };

  // ========= ROTATING SUNBURST =========
  function drawSunburst() {
    const cx = W * 0.5;
    const cy = H + 60;                          // anchor just below the bottom edge
    const baseAngle = time * 0.00006;           // very slow rotation
    const rayCount = 36;
    const maxLen = Math.hypot(W, H) * 0.75;

    ctx.save();
    ctx.translate(cx, cy);
    ctx.rotate(baseAngle);

    for (let i = 0; i < rayCount; i++) {
      const a = (Math.PI * 2 / rayCount) * i;
      // Skip rays pointing downward (off-screen)
      if (a > Math.PI * 0.05 && a < Math.PI * 1.95 - Math.PI && a > -Math.PI) {
        // we want only the upper hemisphere (a in [PI, 2PI])
      }
      // Convert to upper hemisphere only
      const angle = -Math.PI / 2 + (i / rayCount - 0.5) * Math.PI * 1.05;
      const breath = Math.sin(time * 0.0008 + i * 0.4) * 0.5 + 0.5;
      const len = maxLen * (0.55 + breath * 0.45);
      const op = 0.04 + breath * 0.06;

      const grad = ctx.createLinearGradient(0, 0, Math.cos(angle) * len, Math.sin(angle) * len);
      grad.addColorStop(0, 'rgba(' + BRASS.r + ',' + BRASS.g + ',' + BRASS.b + ',' + (op * 2.5) + ')');
      grad.addColorStop(0.4, 'rgba(' + BRASS.r + ',' + BRASS.g + ',' + BRASS.b + ',' + op + ')');
      grad.addColorStop(1, 'rgba(' + BRASS.r + ',' + BRASS.g + ',' + BRASS.b + ',0)');

      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(Math.cos(angle) * len, Math.sin(angle) * len);
      ctx.strokeStyle = grad;
      ctx.lineWidth = i % 3 === 0 ? 1.4 : 0.8;
      ctx.stroke();
    }

    // Central glow
    const glowR = 180 + Math.sin(time * 0.001) * 30;
    const radial = ctx.createRadialGradient(0, 0, 0, 0, 0, glowR);
    radial.addColorStop(0, 'rgba(' + ACCENT.r + ',' + ACCENT.g + ',' + ACCENT.b + ',0.28)');
    radial.addColorStop(0.5, 'rgba(' + ACCENT.r + ',' + ACCENT.g + ',' + ACCENT.b + ',0.08)');
    radial.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = radial;
    ctx.beginPath();
    ctx.arc(0, 0, glowR, 0, Math.PI * 2);
    ctx.fill();

    ctx.restore();
  }

  // ========= CONCENTRIC ARCHES (breathing) =========
  function drawArches() {
    const cx = W * 0.5;
    const cy = H + 60;
    const breath = Math.sin(time * 0.0006) * 0.5 + 0.5;

    ctx.save();
    for (let i = 0; i < 5; i++) {
      const r = 220 + i * 90 + breath * 18;
      const op = 0.12 - i * 0.018;
      if (op <= 0) continue;
      ctx.beginPath();
      ctx.arc(cx, cy, r, Math.PI, Math.PI * 2);
      ctx.strokeStyle = 'rgba(' + BRASS.r + ',' + BRASS.g + ',' + BRASS.b + ',' + op + ')';
      ctx.lineWidth = i === 0 ? 1.4 : (i === 1 ? 1 : 0.7);
      ctx.stroke();
    }
    ctx.restore();
  }

  // ========= METALLIC SHIMMER SWEEP =========
  function drawShimmer() {
    const period = 12000;                                 // 12s loop
    const t = (time % period) / period;
    const x = -W * 0.4 + (W * 1.8) * t;
    const angle = -Math.PI / 5;

    ctx.save();
    ctx.translate(x, H * 0.5);
    ctx.rotate(angle);
    const grad = ctx.createLinearGradient(-300, 0, 300, 0);
    grad.addColorStop(0,    'rgba(255, 217, 168, 0)');
    grad.addColorStop(0.45, 'rgba(255, 217, 168, 0)');
    grad.addColorStop(0.5,  'rgba(255, 217, 168, 0.10)');
    grad.addColorStop(0.55, 'rgba(255, 217, 168, 0)');
    grad.addColorStop(1,    'rgba(255, 217, 168, 0)');
    ctx.fillStyle = grad;
    ctx.fillRect(-W, -H, W * 2, H * 2);
    ctx.restore();
  }

  // ========= TOP CHEVRON STRIPE (animated) =========
  function drawChevronStripe() {
    const yTop = 8;
    const yBot = 36;
    const step = 56;
    const offset = (time * 0.012) % step;
    const breath = 0.35 + Math.sin(time * 0.0008) * 0.15;

    ctx.save();
    ctx.lineWidth = 1.1;
    ctx.strokeStyle = 'rgba(' + BRASS.r + ',' + BRASS.g + ',' + BRASS.b + ',' + breath + ')';
    for (let x = -step + offset; x < W + step; x += step) {
      ctx.beginPath();
      ctx.moveTo(x, yBot);
      ctx.lineTo(x + step / 2, yTop);
      ctx.lineTo(x + step, yBot);
      ctx.stroke();
    }
    ctx.restore();
  }

  // ========= CORNER FAN ORNAMENTS =========
  function drawCornerOrnaments() {
    const breath = 0.45 + Math.sin(time * 0.0007) * 0.15;

    function drawFan(cx, cy, scaleX, scaleY) {
      ctx.save();
      ctx.translate(cx, cy);
      ctx.scale(scaleX, scaleY);
      ctx.strokeStyle = 'rgba(' + BRASS.r + ',' + BRASS.g + ',' + BRASS.b + ',' + breath + ')';
      ctx.lineWidth = 1;
      for (let i = 1; i <= 4; i++) {
        const s = i * 22;
        ctx.beginPath();
        ctx.moveTo(0, s);
        ctx.lineTo(s, s);
        ctx.lineTo(s, 0);
        ctx.stroke();
      }
      // Diagonal hairlines
      ctx.strokeStyle = 'rgba(' + BRASS.r + ',' + BRASS.g + ',' + BRASS.b + ',' + (breath * 0.5) + ')';
      ctx.lineWidth = 0.6;
      for (let i = 1; i <= 3; i++) {
        const s = i * 30;
        ctx.beginPath();
        ctx.moveTo(0, s);
        ctx.lineTo(s, 0);
        ctx.stroke();
      }
      ctx.restore();
    }

    drawFan(28, 60,  1,  1);
    drawFan(W - 28, 60, -1,  1);
  }

  // ========= MOUSE PARALLAX HALO =========
  function drawMouseHalo() {
    if (!mouse.active) return;
    const grad = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, 220);
    grad.addColorStop(0, 'rgba(' + ACCENT.r + ',' + ACCENT.g + ',' + ACCENT.b + ',0.18)');
    grad.addColorStop(0.5, 'rgba(' + ACCENT.r + ',' + ACCENT.g + ',' + ACCENT.b + ',0.06)');
    grad.addColorStop(1, 'rgba(0,0,0,0)');
    ctx.fillStyle = grad;
    ctx.fillRect(mouse.x - 220, mouse.y - 220, 440, 440);
  }

  // ========= MAIN LOOP =========
  function animate(ts) {
    time = ts || 0;
    ctx.clearRect(0, 0, W, H);

    drawArches();
    drawSunburst();
    drawCornerOrnaments();
    drawChevronStripe();

    for (let i = 0; i < sparks.length; i++) { sparks[i].update(); sparks[i].draw(); }
    for (let i = 0; i < particles.length; i++) { particles[i].update(); particles[i].draw(); }

    drawShimmer();
    drawMouseHalo();

    animId = requestAnimationFrame(animate);
  }

  // ========= STATIC RENDER (reduced motion) =========
  function renderStatic() {
    time = 0;
    ctx.clearRect(0, 0, W, H);
    drawArches();
    drawSunburst();
    drawCornerOrnaments();
    drawChevronStripe();
    for (let i = 0; i < particles.length; i++) particles[i].draw();
  }

  // ========= INIT =========
  function init() {
    resize();
    particles = [];
    sparks = [];
    for (let i = 0; i < PARTICLE_COUNT; i++) particles.push(new Diamond());
    for (let i = 0; i < SPARK_COUNT; i++) sparks.push(new Spark());
    if (animId) cancelAnimationFrame(animId);
    if (prefersReduce) { renderStatic(); return; }
    animate(0);
  }

  // ========= EVENTS =========
  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function() {
      resize();
      particles.forEach(function(p) { if (p.x > W || p.y > H) p.reset(true); });
      sparks.forEach(function(s) { if (s.x > W || s.y > H) s.reset(true); });
    }, 150);
  });

  canvas.parentElement.addEventListener('mousemove', function(e) {
    const rect = canvas.parentElement.getBoundingClientRect();
    mouse.x = e.clientX - rect.left;
    mouse.y = e.clientY - rect.top;
    mouse.active = true;
  });
  canvas.parentElement.addEventListener('mouseleave', function() {
    mouse.active = false;
  });

  document.addEventListener('visibilitychange', function() {
    if (document.hidden) {
      if (animId) cancelAnimationFrame(animId);
    } else if (!prefersReduce) {
      animate(0);
    }
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:after-swap', init);
})();
</script>

<style>
  #hero-canvas-artdeco {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
</style>
