---
import { Icon } from "astro-icon/components";

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="f-item f-item--brand">
        <img src="/images/logo_kolor2.svg" alt="Art Decor Logo" class="f-logo" />
        <p class="f-desc">Tworzymy wizualną jakość, która buduje wizerunek Twojej firmy od 1996 roku.</p>
        <div class="f-socials">
          <a href="https://www.facebook.com/artdecorreklama/" target="_blank" rel="noopener noreferrer" class="f-social-link" aria-label="Facebook Art Decor">
            <Icon name="mdi:facebook" size={22} />
          </a>
        </div>
      </div>

      <div class="f-item">
        <h4 class="f-title">Nawigacja</h4>
        <nav class="f-nav" aria-label="Stopka – nawigacja">
          <a href="/">Strona główna</a>
          <a href="/o-nas/">O nas</a>
          <a href="/#uslugi">Usługi</a>
          <a href="/realizacje/">Realizacje</a>
          <a href="/kontakt/">Kontakt</a>
        </nav>
      </div>

      <div class="f-item">
        <h4 class="f-title">Kontakt</h4>
        <div class="f-contact-details">
          <a href="tel:+48696293362" class="f-contact-item">
            <Icon name="lucide:phone" size={18} />
            <span>+48 696 293 362</span>
          </a>
          <a href="mailto:biuro@artdecor.net.pl" class="f-contact-item">
            <Icon name="lucide:mail" size={18} />
            <span>biuro@artdecor.net.pl</span>
          </a>
          <div class="f-contact-item">
            <Icon name="lucide:map-pin" size={18} />
            <span>ul. Męczenników Oświęcimskich 16, 43-200 Pszczyna</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="f-wordmark" aria-hidden="true">ART&nbsp;DECOR</div>

  <div class="container">
    <div class="footer-bottom">
      <p>© {year} Art Decor. Wszystkie prawa zastrzeżone.</p>
      <div class="f-bottom-links">
        <a href="/polityka-prywatnosci/">Polityka prywatności</a>
        <a href="/cookies/">Cookies</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--structa-black);
    color: var(--structa-white);
    padding-top: 5rem;
    margin-top: 4rem;
    overflow: hidden;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 2fr 1fr 1.5fr;
      gap: 3rem;
    }
  }

  .f-item {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .f-logo {
    height: 110px;
    width: auto;
    object-fit: contain;
    object-position: left;
    transform: translateX(-10px); /* Dopasowanie marginesu dodanego przez plik SVG */
  }

  .f-desc {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 320px;
    margin: 0;
  }

  .f-socials {
    display: flex;
    gap: 0.75rem;
  }

  .f-social-link {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--structa-white);
    transition: all var(--transition-base);
  }

  .f-social-link:hover {
    background: var(--structa-accent);
    border-color: var(--structa-accent);
    color: #fff;
    transform: translateY(-3px);
  }

  .f-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
  }

  .f-nav {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .f-nav a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.9375rem;
    width: fit-content;
    transition: color var(--transition-fast);
  }

  .f-nav a:hover {
    color: var(--structa-accent);
  }

  .f-contact-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .f-contact-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--transition-fast);
  }

  a.f-contact-item:hover {
    color: var(--structa-white);
  }

  /* Gigantyczny wordmark — znak rozpoznawczy stopki */
  .f-wordmark {
    font-family: var(--font-display);
    font-size: clamp(4rem, 14vw, 13rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.85;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.14);
    user-select: none;
    pointer-events: none;
    transform: translateY(0.08em);
  }

  @supports not (-webkit-text-stroke: 1px black) {
    .f-wordmark {
      color: rgba(255, 255, 255, 0.06);
    }
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.8125rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .f-bottom-links {
    display: flex;
    gap: 2rem;
  }

  .f-bottom-links a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .f-bottom-links a:hover {
    color: var(--structa-white);
  }
</style>
