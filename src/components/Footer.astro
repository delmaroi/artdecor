---
import { Icon } from "astro-icon/components";
import { footerCta } from "../lib/narrative-data";
import { foundedYear } from "../lib/company-data";

const year = new Date().getFullYear();

// Tytuł pasa CTA łamiemy na linie tak samo jak w SectionHeader, żeby wjeżdżał
// linia po linii (obsługa w `src/scripts/animations.ts`, blok 7).
const ctaLines = footerCta.title.split("\n").map((line) => {
  const at = line.indexOf(footerCta.accent);
  return at === -1
    ? { before: line, accent: "", after: "" }
    : {
        before: line.slice(0, at),
        accent: footerCta.accent,
        after: line.slice(at + footerCta.accent.length),
      };
});
---
<footer class="footer">
  <div class="container">
    <section class="footer-cta" aria-labelledby="footer-cta-title">
      {/* Wyrażenia w linii stykają się celowo — patrz komentarz w SectionHeader.astro. */}
      <h2 id="footer-cta-title" class="footer-cta-title reveal-lines">
        {ctaLines.map((line, index) => (
          <span class="sh-line"><span class="sh-line-inner">{line.before}{line.accent && <em>{line.accent}</em>}{line.after}</span>{index < ctaLines.length - 1 ? " " : ""}</span>
        ))}
      </h2>

      <div class="footer-cta-aside">
        <p class="footer-cta-lead">{footerCta.lead}</p>
        <div class="footer-cta-actions">
          <a href={footerCta.primary.href} class="footer-cta-btn">
            {footerCta.primary.text}
            <Icon name="lucide:arrow-up-right" size={18} />
          </a>
          <a href="tel:+48696293362" class="footer-cta-phone">
            <Icon name="lucide:phone" size={18} />
            696 293 362
          </a>
        </div>
      </div>
    </section>

    <div class="footer-top">
      <div class="f-item f-item--brand">
        <img src="/images/logo_kolor2.svg" alt="Art Decor Logo" class="f-logo" />
        <p class="f-desc">Tworzymy wizualną jakość, która buduje wizerunek Twojej firmy od {foundedYear} roku.</p>
        <div class="f-socials">
          <a href="https://www.facebook.com/artdecorreklama/" target="_blank" rel="noopener noreferrer" class="f-social-link" aria-label="Facebook Art Decor">
            <Icon name="mdi:facebook" size={22} />
          </a>
        </div>
      </div>

      <div class="f-item">
        <h4 class="f-title">Nawigacja</h4>
        <nav class="f-nav" aria-label="Stopka – nawigacja">
          <a href="/">Strona główna</a>
          <a href="/o-nas/">O nas</a>
          <a href="/#uslugi">Usługi</a>
          <a href="/realizacje/">Realizacje</a>
          <a href="/kontakt/">Kontakt</a>
        </nav>
      </div>

      <div class="f-item">
        <h4 class="f-title">Kontakt</h4>
        <div class="f-contact-details">
          <a href="tel:+48696293362" class="f-contact-item">
            <Icon name="lucide:phone" size={18} />
            <span>+48 696 293 362</span>
          </a>
          <a href="mailto:biuro@artdecor.net.pl" class="f-contact-item">
            <Icon name="lucide:mail" size={18} />
            <span>biuro@artdecor.net.pl</span>
          </a>
          <div class="f-contact-item">
            <Icon name="lucide:map-pin" size={18} />
            <span>ul. Męczenników Oświęcimskich 16, 43-200 Pszczyna</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="f-wordmark" aria-hidden="true">ART&nbsp;DECOR</div>

  <div class="container">
    <div class="footer-bottom">
      <p>© {year} Art Decor. Wszystkie prawa zastrzeżone.</p>
      <div class="f-bottom-links">
        <a href="/polityka-prywatnosci/">Polityka prywatności</a>
        <a href="/cookies/">Cookies</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--structa-charcoal);
    color: var(--structa-white);
    padding-top: 5rem;
    margin-top: 4rem;
    overflow: hidden;
  }

  /* ── Pas CTA: domknięcie narracji strony ──────────────────────────────
     Powtarza to samo wezwanie co sekcja Kontakt, ale jako statement —
     ostatnia rzecz, którą widać przed danymi teleadresowymi. */
  .footer-cta {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-bottom: 4.5rem;
    margin-bottom: 4.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 900px) {
    .footer-cta {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 4rem;
      padding-bottom: 5.5rem;
      margin-bottom: 5.5rem;
    }
  }

  .footer-cta-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    color: var(--structa-white);
    margin: 0;
  }

  .footer-cta-title em {
    font-style: normal;
    color: var(--structa-accent);
  }

  .footer-cta-aside {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    flex-shrink: 0;
  }

  .footer-cta-lead {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .footer-cta-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Szerokość kolumny wyznacza rząd przycisków, nie limit na kontenerze.
     Wcześniej `max-width: 40ch` siedziało na `.footer-cta-aside` i dusiło ją
     poniżej sumy szerokości obu przycisków, więc `flex-wrap` łamał je na dwie
     linie. Limit nakładamy więc na sam akapit — kolumna przy `flex-shrink: 0`
     dobiera wtedy szerokość do szerszego z dwojga.

     Blok musi stać PO regułach bazowych: `flex-wrap: wrap` ma tę samą
     specyficzność, więc wcześniej nadpisywałoby `nowrap`. */
  @media (min-width: 900px) {
    .footer-cta-lead {
      max-width: 40ch;
    }

    .footer-cta-actions {
      flex-wrap: nowrap;
    }
  }

  .footer-cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.85rem;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 100px;
    background: var(--structa-accent);
    color: #fff;
    white-space: nowrap;
    transition: all var(--transition-base);
  }

  .footer-cta-btn:hover {
    background: var(--structa-accent-hover);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(255, 92, 53, 0.35);
  }

  .footer-cta-btn svg {
    transition: transform var(--transition-base);
  }

  .footer-cta-btn:hover svg {
    transform: translate(2px, -2px);
  }

  .footer-cta-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 1.5rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: var(--structa-white);
    white-space: nowrap;
    transition: all var(--transition-base);
  }

  .footer-cta-phone:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.06);
    color: var(--structa-white);
  }

  @media (max-width: 599px) {
    .footer-cta-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 2fr 1fr 1.5fr;
      gap: 3rem;
    }
  }

  .f-item {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .f-logo {
    height: 110px;
    width: auto;
    object-fit: contain;
    object-position: left;
    transform: translateX(-10px); /* Dopasowanie marginesu dodanego przez plik SVG */
  }

  .f-desc {
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 320px;
    margin: 0;
  }

  .f-socials {
    display: flex;
    gap: 0.75rem;
  }

  .f-social-link {
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--structa-white);
    transition: all var(--transition-base);
  }

  .f-social-link:hover {
    background: var(--structa-accent);
    border-color: var(--structa-accent);
    color: #fff;
    transform: translateY(-3px);
  }

  .f-title {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin: 0;
  }

  .f-nav {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .f-nav a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.9375rem;
    width: fit-content;
    transition: color var(--transition-fast);
  }

  .f-nav a:hover {
    color: var(--structa-accent);
  }

  .f-contact-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .f-contact-item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
    font-size: 0.9375rem;
    transition: color var(--transition-fast);
  }

  a.f-contact-item:hover {
    color: var(--structa-white);
  }

  /* Gigantyczny wordmark — znak rozpoznawczy stopki */
  .f-wordmark {
    font-family: var(--font-display);
    font-size: clamp(4rem, 14vw, 13rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.85;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.14);
    user-select: none;
    pointer-events: none;
    transform: translateY(0.08em);
  }

  @supports not (-webkit-text-stroke: 1px black) {
    .f-wordmark {
      color: rgba(255, 255, 255, 0.06);
    }
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-block: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: center;
    color: rgba(255, 255, 255, 0.4);
    font-size: 0.8125rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .f-bottom-links {
    display: flex;
    gap: 2rem;
  }

  .f-bottom-links a {
    color: inherit;
    text-decoration: none;
    transition: color var(--transition-base);
  }

  .f-bottom-links a:hover {
    color: var(--structa-white);
  }
</style>
