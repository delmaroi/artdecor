---
/**
 * Propozycja C — kolaż prawdziwych realizacji.
 * Trzy zdjęcia jako przechylone karty: produkcja w warsztacie → montaż →
 * gotowa realizacja. Karty wjeżdżają po kolei, potem delikatnie „pływają";
 * kursor przesuwa je w paralaksie, a karta pod kursorem unosi się i prostuje.
 * Tekst hero leży nad grafiką, więc najechanie liczymy z pozycji kursora.
 */
import { Image } from "astro:assets";
import { asset } from "../../lib/images";
import { yearsOnMarket, foundedYear } from "../../lib/company-data";

const cards = [
  {
    src: "/images/portfolio/litery-blokowe/litera-podswietlana-01.jpg",
    alt: "Podświetlana litera w warsztacie Art Decor",
    step: "01",
    tag: "Produkcja",
    label: "Litera LED · warsztat",
    cls: "c-card--a",
  },
  {
    src: "/images/facebook/mivardi.jpg",
    alt: "Podświetlane litery Mivardi na hali nocą",
    step: "02",
    tag: "Montaż",
    label: "Mivardi · Czechy",
    cls: "c-card--b",
  },
  {
    src: "/images/portfolio/litery-blokowe/optyk-karolina-01.jpg",
    alt: "Świecący szyld okulisty nocą",
    step: "03",
    tag: "Efekt",
    label: "Optyk · Bieruń",
    cls: "c-card--c",
  },
];
---
<div class="c" data-collage>
  <div class="c-glow"></div>

  {cards.map((card, i) => (
    <figure class:list={["c-card", card.cls]} style={`--i:${i}`} data-depth={(i + 1) * 0.5}>
      <div class="c-float">
        <div class="c-media">
          <Image
            src={asset(card.src)}
            alt={card.alt}
            widths={[320, 640]}
            sizes="22vw"
            loading="eager"
            decoding="async"
          />
          <span class="c-step">{card.step}</span>
        </div>
        <figcaption>
          <span class="c-tag">{card.tag}</span>
          <span class="c-label">{card.label}</span>
        </figcaption>
      </div>
    </figure>
  ))}

  <div class="c-badge">
    <span class="c-badge-num">{yearsOnMarket}</span>
    <span class="c-badge-text">
      <b>lat na rynku</b>
      od {foundedYear} roku
    </span>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-collage]").forEach((root) => {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const cards = [...root.querySelectorAll<HTMLElement>("[data-depth]")];
    let raf = 0;
    let last: PointerEvent | null = null;

    const update = () => {
      raf = 0;
      if (!last) return;
      const e = last;
      const nx = e.clientX / innerWidth - 0.5;
      const ny = e.clientY / innerHeight - 0.5;

      // karta pod kursorem — wybieramy najwyżej leżącą (największy z-index)
      let hit: HTMLElement | null = null;
      for (const c of cards) {
        const r = c.getBoundingClientRect();
        if (e.clientX > r.left && e.clientX < r.right && e.clientY > r.top && e.clientY < r.bottom) {
          if (!hit || Number(getComputedStyle(c).zIndex) > Number(getComputedStyle(hit).zIndex)) hit = c;
        }
      }

      cards.forEach((c) => {
        const d = Number(c.dataset.depth);
        c.style.setProperty("--px", `${nx * d * 34}px`);
        c.style.setProperty("--py", `${ny * d * 24}px`);
        c.classList.toggle("is-hover", c === hit);
      });
      root.classList.toggle("has-hover", !!hit);
    };

    window.addEventListener("pointermove", (e) => {
      last = e;
      if (!raf) raf = requestAnimationFrame(update);
    }, { passive: true });
  });
</script>

<style>
  .c {
    position: relative;
    height: 100%;
    container-type: inline-size;
  }

  /* ciepła poświata za kartami — wiąże je z tłem hero */
  .c-glow {
    position: absolute;
    inset: 10% 5% 0 20%;
    background: radial-gradient(ellipse at 55% 45%, rgba(255, 92, 53, 0.22), transparent 65%);
    filter: blur(30px);
    opacity: 0;
    animation: c-fade 1.6s ease 0.6s forwards;
  }

  .c-card {
    --px: 0px;
    --py: 0px;
    --rot: 0deg;
    position: absolute;
    margin: 0;
    translate: var(--px) var(--py);
    rotate: var(--rot);
    transition:
      translate 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      rotate 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      scale 0.5s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.4s ease;
    opacity: 0;
    animation: c-in 1s cubic-bezier(0.2, 0.9, 0.25, 1.15) calc(0.2s + var(--i) * 0.16s) forwards;
  }

  /* karta pod kursorem: prostuje się, wychodzi na wierzch, reszta przygasa */
  .c-card.is-hover {
    rotate: 0deg;
    scale: 1.05;
    z-index: 10 !important;
  }

  .c.has-hover .c-card:not(.is-hover) {
    filter: brightness(0.7) saturate(0.85);
  }

  /* osobna warstwa na „pływanie", żeby nie walczyć z paralaksą */
  .c-float {
    padding: 0.45rem 0.45rem 0;
    background: #f6f7fa;
    border-radius: 16px;
    box-shadow:
      0 40px 70px -25px rgba(5, 8, 18, 0.75),
      0 0 0 1px rgba(255, 255, 255, 0.08);
    animation: c-bob 7s ease-in-out calc(1.4s + var(--i) * -2.1s) infinite;
  }

  .c-card.is-hover .c-float {
    box-shadow:
      0 50px 80px -25px rgba(5, 8, 18, 0.85),
      0 0 0 2px var(--structa-accent),
      0 0 40px rgba(255, 92, 53, 0.35);
  }

  .c-media {
    position: relative;
    overflow: hidden;
    border-radius: 11px;
    aspect-ratio: var(--ar);
  }

  .c-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .c-card.is-hover .c-media :global(img) {
    transform: scale(1.06);
  }

  /* numer etapu — w stylu numeracji sekcji „01/02/03" na stronie */
  .c-step {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    background: rgba(22, 29, 46, 0.72);
    backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .c-card figcaption {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 0.35rem 0.8rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--structa-black);
    white-space: nowrap;
  }

  .c-label {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .c-tag {
    flex: none;
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    background: rgba(255, 92, 53, 0.12);
    color: var(--structa-accent);
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  /* produkcja — z tyłu, po lewej */
  .c-card--a {
    --ar: 4 / 3.2;
    --rot: -7deg;
    left: 0;
    top: 16%;
    width: 40%;
    z-index: 1;
  }

  /* montaż — pionowo, na środku, najwyżej */
  .c-card--b {
    --ar: 9 / 13;
    --rot: 3deg;
    left: 30%;
    top: 0;
    width: 33%;
    z-index: 3;
  }

  /* efekt — po prawej, niżej */
  .c-card--c {
    --ar: 4 / 3.2;
    --rot: -2.5deg;
    right: 0;
    top: 30%;
    width: 39%;
    z-index: 2;
  }

  @keyframes c-in {
    from {
      opacity: 0;
      transform: translateY(60px) rotate(8deg) scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes c-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes c-fade {
    to { opacity: 1; }
  }

  /* ── plakietka „20 lat" — w języku kart: jasna, granat + akcent ───── */
  .c-badge {
    position: absolute;
    right: 2%;
    top: 2%;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem 0.6rem 0.7rem;
    border-radius: 14px;
    background: #f6f7fa;
    box-shadow: 0 20px 40px -18px rgba(5, 8, 18, 0.7);
    opacity: 0;
    animation: c-badge-in 0.7s cubic-bezier(0.2, 0.9, 0.25, 1.2) 1.1s forwards;
  }

  .c-badge-num {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
    background: var(--structa-accent);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .c-badge-text {
    display: flex;
    flex-direction: column;
    font-size: 0.6875rem;
    line-height: 1.35;
    color: var(--structa-gray-text, #6b7280);
  }

  .c-badge-text b {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--structa-black);
  }

  @keyframes c-badge-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Wąski kontener (telefon): same etykiety etapów, mniejsza plakietka
     schodzi na dół, żeby nie zasłaniać kart. */
  @container (max-width: 460px) {
    .c-label {
      display: none;
    }

    .c-card figcaption {
      padding: 0.45rem 0.2rem 0.5rem;
    }

    .c-step {
      top: 0.35rem;
      left: 0.35rem;
      font-size: 0.5625rem;
    }

    .c-badge {
      top: auto;
      right: auto;
      left: 50%;
      bottom: -6%;
      translate: -50% 0;
      gap: 0.5rem;
      padding: 0.35rem 0.7rem 0.35rem 0.4rem;
      border-radius: 10px;
    }

    .c-badge-num {
      width: 2rem;
      height: 2rem;
      border-radius: 7px;
      font-size: 1rem;
    }

    .c-badge-text {
      font-size: 0.5625rem;
    }

    .c-badge-text b {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .c-card,
    .c-badge,
    .c-glow,
    .c-float {
      animation: none;
      opacity: 1;
      transition: none;
    }
  }
</style>
