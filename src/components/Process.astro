---
import SectionHeader from "./SectionHeader.astro";
import SectionRule from "./SectionRule.astro";
import { process } from "../lib/narrative-data";
---
<section class="section process" id="jak-pracujemy">
  <div class="container">
    <SectionRule />
    <SectionHeader
      eyebrow={process.eyebrow}
      title={process.title}
      accent={process.accent}
      lead={process.lead}
      align="split"
    />

    <ol class="process-steps" data-stagger-grid>
      {process.steps.map((step, index) => (
        <li class="process-step">
          <span class="process-step-num">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="process-step-title">{step.title}</h3>
          <p class="process-step-body">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--structa-offwhite);
  }

  .process-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--paper-line);
  }

  @media (min-width: 700px) {
    .process-steps {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 3rem;
    }
  }

  @media (min-width: 1100px) {
    .process-steps {
      grid-template-columns: repeat(4, 1fr);
      column-gap: 2.5rem;
    }
  }

  .process-step {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--paper-line);
  }

  @media (min-width: 1100px) {
    .process-step {
      padding-block: 2.5rem 0;
      border-bottom: none;
    }
  }

  .process-step-num {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--structa-accent);
  }

  .process-step-title {
    font-family: var(--font-display);
    font-size: clamp(1.1875rem, 1.8vw, 1.4375rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--structa-black);
    margin: 0;
  }

  .process-step-body {
    font-size: 0.9688rem;
    line-height: 1.65;
    color: var(--structa-gray-text);
    max-width: 36ch;
    margin: 0;
  }
</style>
