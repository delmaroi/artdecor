---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { asset } from "../lib/images";
import type { PortfolioItem } from "../types/index";

const categories = [
  "Wszystko",
  "Kasetony z dibondu",
  "Litery blokowe",
  "Litery przestrzenne",
  "Oklejanie samochodów",
  "Oklejanie witryn",
  "Piaskowanie artystyczne",
  "Punkty gastronomiczne",
  "Systemy wystawiennicze",
  "Szyldy szklane",
];

const portfolioItems: PortfolioItem[] = [
  // Pylony
  { id: 1, title: "Pylon reklamowy - Kancelarie", category: "Kasetony z dibondu", image: "/images/portfolio/pylony-totemy/pylon-1.jpg" },
  { id: 2, title: "Totem reklamowy LED", category: "Kasetony z dibondu", image: "/images/portfolio/pylony-totemy/pylon-2.jpg" },
  { id: 3, title: "Nowoczesny pylon firmowy", category: "Kasetony z dibondu", image: "/images/portfolio/pylony-totemy/pylon-3.jpg" },

  // Kasetony
  { id: 4, title: "Kaseton z dibondu frezowany", category: "Kasetony z dibondu", image: "/images/portfolio/kasetony-z-dibondu/kaseton-1.jpg" },
  { id: 5, title: "Szyld świetlny LED", category: "Kasetony z dibondu", image: "/images/portfolio/kasetony-z-dibondu/kaseton-2.jpg" },
  { id: 6, title: "Kaseton reklamowy - Pracownia Fryzur", category: "Kasetony z dibondu", image: "/images/portfolio/kasetony-z-dibondu/kaseton-3.jpg" },

  // Litery Blokowe
  { id: 7, title: "Litery blokowe podświetlane", category: "Litery blokowe", image: "/images/portfolio/litery-blokowe/litera-1.jpg" },
  { id: 8, title: "Napis LED przestrzenny", category: "Litery blokowe", image: "/images/portfolio/litery-blokowe/litera-2.jpg" },
  { id: 9, title: "Logo firmowe na elewacji", category: "Litery blokowe", image: "/images/portfolio/litery-blokowe/litera-3.jpg" },

  // Witryny
  { id: 10, title: "Oklejanie witryny sklepowej", category: "Oklejanie witryn", image: "/images/portfolio/oklejanie-witryn/witryna-1.jpg" },
  { id: 11, title: "Grafika na szkle - biuro", category: "Oklejanie witryn", image: "/images/portfolio/oklejanie-witryn/witryna-2.jpg" },
  { id: 12, title: "Folia szroniona na witrynie", category: "Oklejanie witryn", image: "/images/portfolio/oklejanie-witryn/witryna-3.jpg" },

  // Samochody
  { id: 13, title: "Reklama na samochodzie dostawczym", category: "Oklejanie samochodów", image: "/images/portfolio/oklejanie-samochodow/auto-1.jpg" },
  { id: 14, title: "Oklejanie busa firmowego", category: "Oklejanie samochodów", image: "/images/portfolio/oklejanie-samochodow/auto-2.jpg" },
  { id: 15, title: "Grafika reklamowa na pojazd", category: "Oklejanie samochodów", image: "/images/portfolio/oklejanie-samochodow/auto-3.jpg" },
];
---
<section class="section portfolio" id="portfolio">
  <div class="container">
    <div class="portfolio-header">
      <div>
        <p class="eyebrow">Portfolio</p>
        <h2 class="portfolio-heading">Nasze ostatnie <em>realizacje</em></h2>
      </div>
      <p class="portfolio-lead">
        Zobacz, jak pomagamy naszym klientom wyróżnić się na tle konkurencji.
      </p>
    </div>

    <div class="portfolio-filters" role="group" aria-label="Filtruj realizacje">
      {categories.map((cat, index) => (
        <button
          type="button"
          class="filter-btn"
          data-filter={cat === "Wszystko" ? "all" : cat.toLowerCase().replace(/\s+/g, "-")}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {cat}
        </button>
      ))}
    </div>

    <ul class="portfolio-grid" data-stagger-grid>
      {portfolioItems.map((item) => (
        <li class="portfolio-item" data-category={item.category.toLowerCase().replace(/\s+/g, "-")}>
          <figure class="portfolio-card">
            <div class="portfolio-image-wrapper">
              <Image
                src={asset(item.image)}
                alt={`${item.title} — realizacja Art Decor Pszczyna, kategoria: ${item.category}`}
                loading="lazy"
                decoding="async"
                width={800}
              />
              <span class="portfolio-hover-icon" aria-hidden="true">
                <Icon name="lucide:arrow-up-right" size={20} />
              </span>
            </div>
            <figcaption class="portfolio-caption">
              <div>
                <p class="portfolio-category">{item.category}</p>
                <h3 class="portfolio-title">{item.title}</h3>
              </div>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .portfolio {
    background: var(--structa-white);
  }

  .portfolio-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 900px) {
    .portfolio-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 4rem;
    }
  }

  .portfolio-header .eyebrow {
    margin: 0 0 1.25rem;
  }

  .portfolio-heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 0;
    color: var(--structa-black);
  }

  .portfolio-heading em {
    font-style: normal;
    color: var(--structa-accent);
  }

  .portfolio-lead {
    color: var(--structa-gray-text);
    max-width: 40ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    margin: 0;
  }

  .portfolio-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--paper-line);
  }

  .filter-btn {
    padding: 0.55rem 1.15rem;
    background: transparent;
    border: 1px solid var(--paper-line);
    border-radius: 100px;
    color: var(--structa-gray-text);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--structa-black);
    color: var(--structa-black);
  }

  .filter-btn[aria-pressed="true"] {
    background: var(--structa-black);
    border-color: var(--structa-black);
    color: var(--structa-white);
  }

  .portfolio-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2.5rem 1.5rem;
  }

  @media (min-width: 640px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .portfolio-card {
    margin: 0;
  }

  .portfolio-image-wrapper {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--structa-offwhite);
  }

  .portfolio-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .portfolio-item:hover .portfolio-card img {
    transform: scale(1.06);
  }

  .portfolio-hover-icon {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 2.75rem;
    height: 2.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--structa-white);
    color: var(--structa-black);
    border-radius: 50%;
    opacity: 0;
    transform: translateY(8px);
    transition: all var(--transition-base);
  }

  .portfolio-item:hover .portfolio-hover-icon {
    opacity: 1;
    transform: translateY(0);
  }

  .portfolio-caption {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
  }

  .portfolio-category {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--structa-accent);
    margin: 0 0 0.35rem;
  }

  .portfolio-title {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--structa-black);
    margin: 0;
    line-height: 1.25;
  }
</style>


<script>
  const filterBtns = document.querySelectorAll('.filter-btn');
  const portfolioItems = document.querySelectorAll('.portfolio-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update active state
      filterBtns.forEach(b => b.setAttribute('aria-pressed', 'false'));
      btn.setAttribute('aria-pressed', 'true');

      // Filter items
      portfolioItems.forEach(item => {
        const category = item.getAttribute('data-category');
        if (filter === 'all' || category === filter) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
