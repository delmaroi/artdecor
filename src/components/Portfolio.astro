---
import { getImage } from "astro:assets";
import PortfolioCard from "./PortfolioCard.astro";
import SectionHeader from "./SectionHeader.astro";
import SectionRule from "./SectionRule.astro";
import { asset } from "../lib/images";
import type { PortfolioItem } from "../types/index";

interface Props {
  /** Pełna lista realizacji (strona /realizacje/). Domyślnie — skrót na stronę główną. */
  items?: PortfolioItem[];
  categories?: string[];
  /** Na /realizacje/ link „Wszystkie realizacje" prowadziłby do samej siebie. */
  showCta?: boolean;
  /** Ile realizacji pokazać od razu; resztę dokłada przycisk „Pokaż więcej". */
  batchSize?: number;
}

const defaultCategories = [
  "Wszystko",
  "Kasetony z dibondu",
  "Litery blokowe",
  "Litery przestrzenne",
  "Oklejanie samochodów",
  "Oklejanie witryn",
  "Punkty gastronomiczne",
  "Szyldy szklane",
];

const defaultItems: PortfolioItem[] = [
  // Pylony
  { id: 1, title: "Pylon reklamowy - Kancelarie", category: "Kasetony z dibondu", image: "/images/portfolio/pylony-totemy/pylon-1.jpg" },
  { id: 2, title: "Totem reklamowy LED", category: "Kasetony z dibondu", image: "/images/portfolio/pylony-totemy/pylon-2.jpg" },
  { id: 3, title: "Nowoczesny pylon firmowy", category: "Kasetony z dibondu", image: "/images/portfolio/pylony-totemy/pylon-3.jpg" },

  // Kasetony
  { id: 4, title: "Kaseton z dibondu frezowany", category: "Kasetony z dibondu", image: "/images/portfolio/kasetony-z-dibondu/kaseton-1.jpg" },
  { id: 5, title: "Szyld świetlny LED", category: "Kasetony z dibondu", image: "/images/portfolio/kasetony-z-dibondu/kaseton-2.jpg" },
  { id: 6, title: "Kaseton reklamowy - Pracownia Fryzur", category: "Kasetony z dibondu", image: "/images/portfolio/kasetony-z-dibondu/kaseton-3.jpg" },

  // Litery Blokowe
  { id: 7, title: "Litery blokowe podświetlane", category: "Litery blokowe", image: "/images/portfolio/litery-blokowe/litera-1.jpg" },
  { id: 8, title: "Napis LED przestrzenny", category: "Litery blokowe", image: "/images/portfolio/litery-blokowe/litera-2.jpg" },
  { id: 9, title: "Logo firmowe na elewacji", category: "Litery blokowe", image: "/images/portfolio/litery-blokowe/litera-3.jpg" },

  // Witryny
  { id: 10, title: "Oklejanie witryny salonu", category: "Oklejanie witryn", image: "/images/portfolio/oklejanie-witryn/witryna-salon-02.jpg" },
  { id: 11, title: "Grafika na szkle - biuro", category: "Oklejanie witryn", image: "/images/portfolio/oklejanie-witryn/witryna-2.jpg" },
  { id: 12, title: "Folia szroniona na witrynie", category: "Oklejanie witryn", image: "/images/portfolio/oklejanie-witryn/witryna-3.jpg" },

  // Samochody
  { id: 13, title: "Reklama na samochodzie dostawczym", category: "Oklejanie samochodów", image: "/images/portfolio/oklejanie-samochodow/ashwood-01.jpg" },
  { id: 14, title: "Oklejanie busa firmowego", category: "Oklejanie samochodów", image: "/images/portfolio/oklejanie-samochodow/chlodzimy24-03.jpg" },
  { id: 15, title: "Grafika reklamowa na pojazd", category: "Oklejanie samochodów", image: "/images/portfolio/oklejanie-samochodow/auto-3.jpg" },
];

const { items, categories = defaultCategories, showCta = true, batchSize } = Astro.props;

// Podgląd PhotoSwipe: pełne zdjęcie WebP max. 2000 px (te same parametry co
// w galeriach usług, więc Astro nie generuje drugiej kopii) + jego wymiary.
const LIGHTBOX_MAX_WIDTH = 2000;
const portfolioItems = await Promise.all(
  (items ?? defaultItems).map(async (item) => {
    const meta = asset(item.image);
    const width = Math.min(meta.width, LIGHTBOX_MAX_WIDTH);
    const full = await getImage({ src: meta, width, format: "webp" });
    return {
      ...item,
      meta,
      href: full.src,
      width,
      height: Math.round((meta.height * width) / meta.width),
    };
  })
);

// Dalsze realizacje trafiają do <template>: nie obciążają strony, dopóki klient
// o nie nie poprosi. Filtry i przycisk obsługuje skrypt na dole pliku.
const initialItems = batchSize ? portfolioItems.slice(0, batchSize) : portfolioItems;
const laterItems = batchSize ? portfolioItems.slice(batchSize) : [];
---
<section class="section portfolio" id="portfolio">
  <div class="container">
    <SectionRule />
    <SectionHeader
      eyebrow="Portfolio"
      title={"Nasze ostatnie\nrealizacje"}
      accent="realizacje"
      lead="Zobacz, jak pomagamy naszym klientom wyróżnić się na tle konkurencji."
      cta={showCta ? { text: "Wszystkie realizacje", href: "/realizacje/" } : undefined}
      align="split"
    />

    <div class="portfolio-filters" role="group" aria-label="Filtruj realizacje">
      {categories.map((cat, index) => (
        <button
          type="button"
          class="filter-btn"
          data-filter={cat === "Wszystko" ? "all" : cat.toLowerCase().replace(/\s+/g, "-")}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          {cat}
        </button>
      ))}
    </div>

    <ul class="portfolio-grid" data-stagger-grid data-pswp-gallery data-portfolio-list data-batch={batchSize}>
      {initialItems.map((item) => <PortfolioCard {...item} />)}
    </ul>

    {laterItems.length > 0 && (
      <template data-portfolio-rest>
        {laterItems.map((item) => <PortfolioCard {...item} />)}
      </template>
    )}

    <div class="portfolio-more-wrap">
      <button type="button" class="portfolio-more" data-portfolio-more hidden></button>
    </div>
  </div>
</section>

<style>
  .portfolio {
    background: var(--structa-white);
  }

  /* Nagłówek sekcji renderuje SectionHeader.astro — style w globals.css. */

  .portfolio-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--paper-line);
  }

  .filter-btn {
    padding: 0.55rem 1.15rem;
    background: transparent;
    border: 1px solid var(--paper-line);
    border-radius: 100px;
    color: var(--structa-gray-text);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--structa-black);
    color: var(--structa-black);
  }

  .filter-btn[aria-pressed="true"] {
    background: var(--structa-charcoal);
    border-color: var(--structa-black);
    color: var(--structa-white);
  }

  .portfolio-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 2.5rem 1.5rem;
  }

  @media (min-width: 640px) {
    .portfolio-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .portfolio-more-wrap {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
  }

  .portfolio-more {
    padding: 0.85rem 1.75rem;
    background: var(--structa-charcoal);
    border: 1px solid var(--structa-charcoal);
    border-radius: 100px;
    color: var(--structa-white);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .portfolio-more:hover {
    background: var(--structa-black);
  }

  .portfolio-more:focus-visible {
    outline: 2px solid var(--structa-accent);
    outline-offset: 2px;
  }

  .portfolio-more[hidden] {
    display: none;
  }
</style>


<script>
  import { initLightbox } from "../scripts/lightbox";
  initLightbox();

  const list = document.querySelector<HTMLElement>("[data-portfolio-list]");
  const rest = document.querySelector<HTMLTemplateElement>("[data-portfolio-rest]");
  const moreBtn = document.querySelector<HTMLButtonElement>("[data-portfolio-more]");
  const filterBtns = document.querySelectorAll(".filter-btn");

  if (list && moreBtn) {
    const items = [
      ...list.children,
      ...(rest?.content.children ?? []),
    ] as HTMLElement[];
    const batch = Number(list.dataset.batch) || items.length;
    let filter = "all";
    let shown = batch;

    // W DOM są tylko widoczne realizacje, więc podgląd PhotoSwipe przewija dokładnie je.
    const render = () => {
      const matching = items.filter((item) => filter === "all" || item.dataset.category === filter);
      list.replaceChildren(...matching.slice(0, shown));
      const remaining = matching.length - shown;
      moreBtn.hidden = remaining <= 0;
      moreBtn.textContent = `Pokaż więcej (zostało ${remaining})`;
    };

    moreBtn.addEventListener("click", () => {
      shown += batch;
      render();
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        filter = btn.getAttribute("data-filter") ?? "all";
        shown = batch;
        filterBtns.forEach((other) => other.setAttribute("aria-pressed", String(other === btn)));
        render();
      });
    });

    render();
  }
</script>
