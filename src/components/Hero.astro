---
import { Icon } from "astro-icon/components";
import { services } from "../lib/services-data";
import { foundedYear } from "../lib/company-data";

export interface BreadcrumbItem {
  label: string;
  /** Pomiń na ostatnim elemencie — to bieżąca strona, nie link. */
  href?: string;
}

export interface Props {
  title: string;
  subtitle?: string;
  /** Etykieta nad tytułem. Ignorowana, gdy podasz `breadcrumb`. */
  eyebrow?: string;
  /** Ścieżka okruszków — zajmuje miejsce etykiety `eyebrow`. */
  breadcrumb?: BreadcrumbItem[];
  ctaText?: string;
  ctaHref?: string;
  /** `null` ukrywa przycisk poboczny. */
  secondaryCtaText?: string | null;
  secondaryCtaHref?: string;
  /**
   * „home" — pełna wysokość i statystyki firmy (strona główna, O nas).
   * „page" — niższy, bez statystyk (podstrony: realizacje, usługi).
   * Oba warianty dzielą tło, typografię i pasek marquee, więc podstrony
   * czytają się jak ta sama strona, a nie jak osobny szablon.
   */
  variant?: "home" | "page";
}

const {
  title,
  subtitle = "Kompleksowa reklama wizualna – pylony, totemy, kasetony z dibondu, szyldy, oklejanie witryn i samochodów.",
  eyebrow = "Agencja reklamy wizualnej — Pszczyna",
  breadcrumb,
  ctaText = "Skontaktuj się",
  ctaHref = "/kontakt/",
  secondaryCtaText = "Zobacz realizacje",
  secondaryCtaHref = "/realizacje/",
  variant = "home",
} = Astro.props;

const isPage = variant === "page";
const hasExtra = Astro.slots.has("default");

// Ostatnie słowo tytułu dostaje akcent typograficzny
const words = title.trim().split(" ");
const lastWord = words.pop();
const titleStart = words.join(" ");

const marqueeItems = services.map((s) => s.title);
---
<section class:list={["hero", isPage && "hero--page"]}>
  <div class="hero-bg" aria-hidden="true">
    <video class="hero-video" autoplay muted loop playsinline preload="metadata">
      <source src="/videos/hero-loop.mp4" type="video/mp4" />
    </video>
    <div class="hero-video-overlay"></div>
    <div class="hero-grid grid-pattern"></div>
    <div class="hero-glow"></div>
  </div>

  <div class="container hero-inner">
    {breadcrumb ? (
      <nav class="hero-breadcrumb" aria-label="Ścieżka nawigacji">
        {breadcrumb.map((crumb, index) => (
          <>
            {index > 0 && <span class="hero-breadcrumb-sep" aria-hidden="true">/</span>}
            {crumb.href
              ? <a href={crumb.href}>{crumb.label}</a>
              : <span aria-current="page">{crumb.label}</span>}
          </>
        ))}
      </nav>
    ) : (
      <p class="hero-eyebrow">
        <span class="pulse-dot"></span>
        {eyebrow}
      </p>
    )}

    <h1 class="hero-title">
      {titleStart} <em>{lastWord}</em>
    </h1>

    <div class="hero-bottom">
      {subtitle && <p class="hero-subtitle">{subtitle}</p>}

      <div class="hero-actions">
        {ctaText && ctaHref && (
          <a href={ctaHref} class="btn btn-primary">
            {ctaText}
            <Icon name="lucide:arrow-up-right" size={18} />
          </a>
        )}
        {secondaryCtaText && (
          <a href={secondaryCtaHref} class="btn btn-secondary">
            {secondaryCtaText}
          </a>
        )}
      </div>
    </div>

    {hasExtra && (
      <div class="hero-extra">
        <slot />
      </div>
    )}

    {!isPage && (
    <dl class="hero-stats">
      <div class="hero-stat">
        <dt>Na rynku</dt>
        <dd>od {foundedYear}</dd>
      </div>
      <div class="hero-stat">
        <dt>Specjalizacje</dt>
        <dd>{services.length} usług</dd>
      </div>
      <div class="hero-stat">
        <dt>Działamy</dt>
        <dd>Pszczyna i Śląsk</dd>
      </div>
      <div class="hero-stat">
        <dt>Realizacja</dt>
        <dd>projekt → montaż</dd>
      </div>
    </dl>
    )}
  </div>

  <div class="hero-marquee" aria-hidden="true">
    <div class="hero-marquee-track">
      {[0, 1].map(() => (
        <div class="hero-marquee-group">
          {marqueeItems.map((item) => (
            <span class="hero-marquee-item">
              {item}
              <span class="hero-marquee-sep">✦</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(92svh, 64rem);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 9rem;
    overflow: hidden;
    background: var(--structa-charcoal);
    color: var(--structa-white);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .hero-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse at 50% 0%, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at 50% 0%, black 30%, transparent 75%);
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }

  /* rgba(35, 45, 72) to --structa-charcoal (#232D48). Wartości muszą być
     zapisane liczbowo, bo gradienty potrzebują kanału alfa — trzymaj je
     zsynchronizowane z tokenem, inaczej hero rozjedzie się kolorystycznie
     z pozostałymi ciemnymi sekcjami. */
  .hero-video-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 50% 30%, rgba(35, 45, 72, 0.2) 0%, rgba(35, 45, 72, 0.6) 60%, rgba(35, 45, 72, 0.88) 100%),
      linear-gradient(180deg, rgba(35, 45, 72, 0.35) 0%, rgba(35, 45, 72, 0.75) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }
  }

  .hero-glow {
    position: absolute;
    top: -30%;
    right: -15%;
    width: 70%;
    height: 90%;
    background: radial-gradient(circle, rgba(255, 92, 53, 0.14) 0%, transparent 65%);
    filter: blur(20px);
  }

  .hero-inner {
    position: relative;
    z-index: 10;
    /* Wcięcie poziome dziedziczy z `.container` (--container-pad) — własna
       wartość podwajałaby je i hero rozjechałoby się z resztą sekcji. */
  }

  /* Wariant podstrony: ta sama oprawa, mniej wysokości i bez statystyk firmy.
     Bez tego hero zajmowałby na podstronie usługi cały ekran, spychając
     właściwą treść poniżej zgięcia. */
  .hero--page {
    min-height: min(62svh, 42rem);
    padding-top: 10rem;
  }

  .hero--page .hero-title {
    font-size: clamp(2.5rem, 6.5vw, 5rem);
    margin-bottom: 2rem;
  }

  .hero--page .hero-bottom {
    margin-bottom: 3rem;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 2rem;
  }

  /* Breadcrumb zajmuje miejsce etykiety `eyebrow` — ten sam stopień pisma
     i ten sam odstęp do tytułu, żeby nie powstał drugi poziom drobnicy. */
  .hero-breadcrumb {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 2rem;
  }

  .hero-breadcrumb a {
    color: rgba(255, 255, 255, 0.55);
    transition: color var(--transition-fast);
  }

  .hero-breadcrumb a:hover {
    color: var(--structa-white);
  }

  .hero-breadcrumb [aria-current="page"] {
    color: var(--structa-accent);
  }

  .hero-breadcrumb-sep {
    color: rgba(255, 255, 255, 0.3);
  }

  /* Slot na treść specyficzną dla strony (np. definicja usługi pod CTA). */
  .hero-extra {
    margin-bottom: 3rem;
    max-width: 62ch;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    background: var(--structa-accent);
    border-radius: 50%;
    position: relative;
    flex-shrink: 0;
  }

  .pulse-dot::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: var(--structa-accent);
    opacity: 0.4;
    animation: ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping {
    75%, 100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.5vw, 7.25rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.045em;
    margin: 0 0 2.5rem;
    max-width: 25ch;
    text-wrap: balance;
  }

  .hero-title em {
    font-style: normal;
    color: var(--structa-accent);
    position: relative;
    white-space: nowrap;
  }

  .hero-bottom {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 900px) {
    .hero-bottom {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 4rem;
    }
  }

  .hero-subtitle {
    font-size: clamp(1rem, 1.4vw, 1.1875rem);
    color: rgba(255, 255, 255, 0.65);
    max-width: 52ch;
    line-height: 1.65;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem 1.85rem;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 100px;
    transition: all var(--transition-base);
    text-decoration: none;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--structa-accent);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--structa-accent-hover);
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(255, 92, 53, 0.35);
    color: #fff;
  }

  .btn-primary :global(svg) {
    transition: transform var(--transition-base);
  }

  .btn-primary:hover :global(svg) {
    transform: translate(2px, -2px);
  }

  .btn-secondary {
    background: transparent;
    color: var(--structa-white);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .btn-secondary:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.06);
    color: var(--structa-white);
    transform: translateY(-2px);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 2rem;
    margin: 0;
    padding: 2rem 0 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  @media (min-width: 768px) {
    .hero-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .hero-stat dt {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin-bottom: 0.4rem;
  }

  .hero-stat dd {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--structa-white);
    margin: 0;
  }

  /* ── Pasek marquee z usługami ── */
  .hero-marquee {
    position: relative;
    z-index: 10;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
    padding-block: 1.1rem;
  }

  .hero-marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .hero-marquee-group {
    display: flex;
    flex-shrink: 0;
  }

  .hero-marquee-item {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }

  .hero-marquee-sep {
    color: var(--structa-accent);
    font-size: 0.6875rem;
    margin-inline: 1.75rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-marquee-track {
      animation: none;
    }
    .pulse-dot::after {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      padding-top: 8.5rem;
    }
    .hero-title {
      margin-bottom: 1.75rem;
    }
    .hero-bottom {
      margin-bottom: 2.5rem;
    }
    .btn {
      width: 100%;
    }
    .hero-actions {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }
    .hero-stats {
      padding-bottom: 2rem;
    }
  }
</style>
