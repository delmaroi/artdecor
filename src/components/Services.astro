---
import { Icon } from "astro-icon/components";
import { services } from "../lib/services-data";
---
<section class="section services" id="uslugi">
  <div class="container">
    <div class="services-header">
      <div>
        <p class="eyebrow">Nasze usługi</p>
        <h2 class="services-title">Co robimy <em>najlepiej</em></h2>
      </div>
      <p class="services-lead">
        Od koncepcji po montaż – dostarczamy kompletne systemy identyfikacji
        wizualnej dla Twojego biznesu.
      </p>
    </div>

    <ul class="svc-list" data-stagger-grid>
      {services.map((service, index) => (
        <li class="svc-row">
          <a href={`/uslugi/${service.slug}/`} class="svc-link">
            <span class="svc-num">{String(index + 1).padStart(2, "0")}</span>
            <span class="svc-name">{service.title}</span>
            <span class="svc-desc">{service.desc}</span>
            <span class="svc-arrow" aria-hidden="true">
              <Icon name="lucide:arrow-up-right" size={22} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services {
    background: var(--structa-offwhite);
  }

  .services-header {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 4rem;
  }

  @media (min-width: 900px) {
    .services-header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 4rem;
    }
  }

  .eyebrow {
    margin: 0 0 1.25rem;
  }

  .services-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 0;
    color: var(--structa-black);
  }

  .services-title em {
    font-style: normal;
    color: var(--structa-accent);
  }

  .services-lead {
    color: var(--structa-gray-text);
    max-width: 42ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    margin: 0;
  }

  .svc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--paper-line);
  }

  .svc-row {
    border-bottom: 1px solid var(--paper-line);
  }

  .svc-link {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "num name arrow"
      "num desc arrow";
    align-items: center;
    column-gap: 1.5rem;
    row-gap: 0.35rem;
    padding: 1.5rem 1rem;
    color: var(--structa-black);
    text-decoration: none;
    transition: background var(--transition-base), color var(--transition-base), padding var(--transition-base);
  }

  @media (min-width: 900px) {
    .svc-link {
      grid-template-columns: 4.5rem minmax(280px, 1.1fr) 1.6fr auto;
      grid-template-areas: "num name desc arrow";
      column-gap: 2.5rem;
      padding: 1.85rem 1.5rem;
    }
  }

  .svc-num {
    grid-area: num;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--structa-gray-text);
    transition: color var(--transition-base);
  }

  .svc-name {
    grid-area: name;
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .svc-desc {
    grid-area: desc;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--structa-gray-text);
    max-width: 52ch;
    transition: color var(--transition-base);
  }

  .svc-arrow {
    grid-area: arrow;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--paper-line);
    border-radius: 50%;
    color: var(--structa-black);
    transition: all var(--transition-base);
    flex-shrink: 0;
  }

  /* Hover: rząd wypełnia się atramentem */
  .svc-link:hover {
    background: var(--structa-black);
    color: var(--structa-white);
  }

  .svc-link:hover .svc-num {
    color: var(--structa-accent);
  }

  .svc-link:hover .svc-desc {
    color: rgba(255, 255, 255, 0.65);
  }

  .svc-link:hover .svc-arrow {
    background: var(--structa-accent);
    border-color: var(--structa-accent);
    color: #fff;
    transform: rotate(45deg);
  }

  .svc-link:focus-visible {
    outline: 2px solid var(--structa-accent);
    outline-offset: -2px;
  }

  @media (max-width: 899px) {
    .svc-desc {
      display: none;
    }
    .svc-arrow {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
