---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Hero from "../../components/Hero.astro";
import Portfolio from "../../components/Portfolio.astro";
import ContactBlock from "../../components/ContactBlock.astro";
import "../../styles/globals.css";

const site = Astro.site ?? new URL("https://www.artdecor.net.pl/");

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Strona główna", item: site.origin + "/" },
    { "@type": "ListItem", position: 2, name: "Realizacje", item: new URL("/realizacje/", site).href },
  ],
};
---
<Layout
  title="Realizacje – Art Decor Pszczyna | portfolio reklamy wizualnej"
  ogBasicTitle="Realizacje Art Decor Pszczyna"
  description="Portfolio Art Decor Pszczyna: pylony i totemy, kasetony z dibondu, litery przestrzenne i blokowe LED, szyldy szklane, oklejanie witryn i samochodów, piaskowanie artystyczne. Zobacz nasze realizacje reklamy wizualnej."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <Header />
  <main>
    <Hero
      variant="page"
      breadcrumb={[
        { label: "Strona główna", href: "/" },
        { label: "Realizacje" },
      ]}
      title="Nasze realizacje"
      subtitle="Wybrane projekty reklamy wizualnej zrealizowane przez Art Decor – od pylonów i kasetonów, przez litery przestrzenne i szyldy szklane, po oklejanie witryn i samochodów. Każda realizacja powstaje kompleksowo, w oparciu o własny park maszynowy – od projektu po montaż."
      ctaText="Zapytaj o wycenę"
      ctaHref="/kontakt/"
      secondaryCtaText="Zobacz usługi"
      secondaryCtaHref="/#uslugi"
    />

    <Portfolio />
    <ContactBlock />
  </main>
  <Footer />
</Layout>

