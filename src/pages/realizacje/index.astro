---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Portfolio from "../../components/Portfolio.astro";
import ContactBlock from "../../components/ContactBlock.astro";
import "../../styles/globals.css";

const site = Astro.site ?? new URL("https://www.artdecor.net.pl/");

const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Strona główna", item: site.origin + "/" },
    { "@type": "ListItem", position: 2, name: "Realizacje", item: new URL("/realizacje/", site).href },
  ],
};
---
<Layout
  title="Realizacje – Art Decor Pszczyna | portfolio reklamy wizualnej"
  ogBasicTitle="Realizacje Art Decor Pszczyna"
  description="Portfolio Art Decor Pszczyna: pylony i totemy, kasetony z dibondu, litery przestrzenne i blokowe LED, szyldy szklane, oklejanie witryn i samochodów, piaskowanie artystyczne. Zobacz nasze realizacje reklamy wizualnej."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <Header />
  <main>
    <section class="realizacje-intro">
      <div class="container">
        <nav class="breadcrumb" aria-label="Ścieżka okruszków">
          <a href="/">Strona główna</a>
          <span aria-hidden="true">/</span>
          <span aria-current="page">Realizacje</span>
        </nav>
        <h1 class="realizacje-title">
          Nasze <span class="gradient-text">realizacje</span>
        </h1>
        <p class="realizacje-lead">
          Wybrane projekty reklamy wizualnej zrealizowane przez Art Decor – od pylonów i kasetonów,
          przez litery przestrzenne i szyldy szklane, po oklejanie witryn i samochodów. Każda realizacja
          powstaje kompleksowo, w oparciu o własny park maszynowy – od projektu po montaż.
        </p>
      </div>
    </section>

    <Portfolio />
    <ContactBlock />
  </main>
  <Footer />
</Layout>

<style>
  .realizacje-intro {
    /* Odstęp u góry czyszczący pływający, przyklejony header */
    padding-block: 11rem 1rem;
    background: var(--structa-charcoal);
    color: var(--structa-white);
    text-align: center;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 1.5rem;
  }

  .breadcrumb a {
    color: rgba(255, 255, 255, 0.7);
    transition: color var(--transition-base);
  }

  .breadcrumb a:hover {
    color: #ffffff;
  }

  .breadcrumb [aria-current="page"] {
    color: var(--structa-accent);
  }

  .realizacje-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
    color: var(--structa-white);
  }

  .realizacje-lead {
    max-width: 720px;
    margin: 0 auto;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  @media (max-width: 767px) {
    .realizacje-intro {
      padding-block: 9rem 0.5rem;
      text-align: left;
    }
    .breadcrumb {
      justify-content: flex-start;
    }
  }
</style>
