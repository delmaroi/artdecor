---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SectionRule from "../components/SectionRule.astro";
import HatchBand from "../components/HatchBand.astro";
import { Icon } from "astro-icon/components";
import {
  foundedYear,
  aboutIntro,
  aboutPillars,
  machinery,
  aboutStats,
} from "../lib/about-data";
import "../styles/globals.css";
---
<Layout
  title={`O nas – Art Decor Pszczyna | Reklama wizualna od ${foundedYear} roku`}
  description={`Art Decor Pszczyna – agencja reklamy wizualnej od ${foundedYear} roku. Projekt, produkcja i montaż w jednym miejscu: własny ploter CNC, druk wielkoformatowy, termoformowanie i cięcie folii. Pięć maszyn, jeden wykonawca, jedna odpowiedzialność.`}
>
  <Header />
  <main>
    <Hero
      title="Pasja i doświadczenie"
      subtitle={`Reklama wizualna od ${foundedYear} roku – od projektu po montaż. Własny park maszynowy: CNC, druk, cięcie, termoformowanie.`}
      ctaText="Skontaktuj się"
      ctaHref="/kontakt/"
    />

    <section class="section about-intro-section">
      <div class="container">
        <SectionRule />
        <SectionHeader
          eyebrow={aboutIntro.eyebrow}
          title={aboutIntro.title}
          accent={aboutIntro.accent}
          align="stack"
        />

        <div class="about-prose" data-stagger-grid>
          {aboutIntro.paragraphs.map((text) => (
            <p class="about-para">{text}</p>
          ))}
        </div>

        <dl class="about-stats" data-stagger-grid>
          {aboutStats.map((stat) => (
            <div class="about-stat">
              <dt>{stat.value}</dt>
              <dd>{stat.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section pillars">
      <div class="container">
        <SectionRule />
        <SectionHeader
          eyebrow={aboutPillars.eyebrow}
          title={aboutPillars.title}
          accent={aboutPillars.accent}
          lead={aboutPillars.lead}
          align="split"
        />

        <ol class="pillar-list" data-stagger-grid>
          {aboutPillars.items.map((item, index) => (
            <li class="pillar">
              <span class="pillar-num">{String(index + 1).padStart(2, "0")}</span>
              <h3 class="pillar-title">{item.title}</h3>
              <p class="pillar-body">{item.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <HatchBand />

    <section class="section machinery">
      <div class="container">
        <SectionRule />
        <SectionHeader
          eyebrow={machinery.eyebrow}
          title={machinery.title}
          accent={machinery.accent}
          lead={machinery.lead}
          align="split"
        />

        <ul class="machine-grid" data-stagger-grid>
          {machinery.items.map((machine) => (
            <li class="machine">
              <span class="machine-icon" aria-hidden="true">
                <Icon name={machine.icon} size={24} />
              </span>
              <h3 class="machine-name">{machine.name}</h3>
              <p class="machine-body">{machine.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section about-cta">
      <div class="container">
        <SectionRule />
        <SectionHeader
          eyebrow="Kontakt"
          title={"Masz pomysł\nna reklamę?"}
          accent="na reklamę?"
          lead="Zrealizujemy go od koncepcji po gotowy produkt na Twoim budynku. Wycena jest bezpłatna."
          cta={{ text: "Skontaktuj się z nami", href: "/kontakt/" }}
          align="split"
        />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  /* Nagłówki sekcji renderuje SectionHeader.astro — style w globals.css. */

  .about-intro-section {
    background: var(--structa-offwhite);
  }

  /* ── Wstęp ─────────────────────────────────────────────────────────── */

  /* Wstęp wypełnia pełną szerokość sekcji, ale nie jako jeden szeroki blok —
     przy 1320px dałoby to linie po ~150 znaków, czyli dwa razy powyżej progu
     czytelności. Trzy kolumny wypełniają tę samą szerokość, trzymając linię
     w okolicach 60 znaków. */
  .about-prose {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 700px) {
    .about-prose {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }

  @media (min-width: 1100px) {
    .about-prose {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  /* Pierwszy akapit prowadzi wzrok w tekst. Wyróżnienie działa tylko wtedy,
     gdy akapity są pod sobą — w rzędzie równorzędnych kolumn nierówny stopień
     pisma czyta się jak błąd składu, więc powyżej progu je wyłączamy. */
  .about-para:first-child {
    font-size: clamp(1.125rem, 1.7vw, 1.375rem);
    line-height: 1.6;
    color: var(--structa-black);
  }

  @media (min-width: 700px) {
    .about-para:first-child {
      font-size: 1.0625rem;
      line-height: 1.75;
      color: var(--structa-gray-text);
    }
  }

  .about-para {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--structa-gray-text);
    margin: 0;
  }

  .about-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin: 4rem 0 0;
    padding-top: 2.5rem;
    border-top: 1px solid var(--paper-line);
  }

  @media (min-width: 700px) {
    .about-stats {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .about-stat dt {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--structa-accent);
  }

  .about-stat dd {
    margin: 0.75rem 0 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--structa-gray-text);
    max-width: 22ch;
  }

  /* ── Filary ────────────────────────────────────────────────────────── */

  .pillars {
    background: var(--structa-white);
  }

  .pillar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--paper-line);
  }

  @media (min-width: 900px) {
    .pillar-list {
      grid-template-columns: repeat(3, 1fr);
      column-gap: 3.5rem;
    }
  }

  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--paper-line);
  }

  @media (min-width: 900px) {
    .pillar {
      padding-block: 2.75rem 0;
      border-bottom: none;
    }
  }

  .pillar-num {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--structa-accent);
  }

  .pillar-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--structa-black);
    margin: 0;
  }

  .pillar-body {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--structa-gray-text);
    margin: 0;
  }

  /* ── Park maszynowy ────────────────────────────────────────────────── */

  .machinery {
    background: var(--structa-offwhite);
  }

  .machine-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 700px) {
    .machine-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1100px) {
    .machine-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .machine {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 2rem;
    background: var(--structa-white);
    border: 1px solid var(--structa-border);
    border-radius: var(--radius-lg);
    transition: border-color var(--transition-base), transform var(--transition-base);
  }

  .machine:hover {
    border-color: var(--structa-accent);
    transform: translateY(-4px);
  }

  .machine-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--structa-offwhite);
    color: var(--structa-accent);
    flex-shrink: 0;
  }

  .machine-name {
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--structa-black);
    margin: 0;
  }

  .machine-body {
    font-size: 0.9688rem;
    line-height: 1.65;
    color: var(--structa-gray-text);
    margin: 0;
  }

  /* ── CTA ───────────────────────────────────────────────────────────── */

  .about-cta {
    background: var(--structa-white);
  }
</style>
